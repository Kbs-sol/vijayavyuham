{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vijayavyuham",
  "compatibility_date": "2026-08-15",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // NOTE: No database bindings are declared here on purpose.
  // The app uses Supabase over HTTPS (REST API) via env vars/secrets,
  // NOT a Cloudflare binding — so the site builds & deploys cleanly
  // even before any service is connected (offline fallback mode).
  //
  // Configure these in the Cloudflare Pages dashboard
  // (Settings -> Environment variables / Secrets) — never hardcode:
  //   SUPABASE_URL           = https://<project-ref>.supabase.co
  //   SUPABASE_SERVICE_KEY   = <service_role key>   (secret)
  //   SESSION_SECRET         = <random long string> (secret)
  //   ADMIN_DEV_PASSWORD     = <optional override>  (secret)
  //   ADMIN_MGR_PASSWORD     = <optional override>  (secret)
  //   CLOUDINARY_CLOUD_NAME  = <optional>
}
